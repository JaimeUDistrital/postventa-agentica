# Copia este archivo a un archivo de entorno local y rellena los valores. Nunca subas valores reales al repo.

# Clave de la API de Gemini. Debe ser de un proyecto SIN facturación (límite de gasto = 0). Sin ella la demo usa el modo determinista.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional: si falta, se usa el modelo por defecto del código (src/core/config).
GEMINI_MODEL=

# Secreto para firmar el token de sesión (HMAC). Genéralo con: openssl rand -base64 32
# En producción es obligatorio: sin él /api/agent responde 500.
SESSION_SECRET=

# Código del jurado (mínimo 12 caracteres) que activa Gemini vía ?codigo=. Genéralo con: openssl rand -hex 16
# Sin él, o si no coincide, la demo funciona en modo determinista.
DEMO_ACCESS_CODE=
